# ---------------------------------------------------------------------------
# .gitignore real para crypto-suite
# Antes no existia: habia un `.gitignore.docx` (un documento de Word), asi que
# no habia ninguna regla activa y `git add .` subiria secretos y binarios.
# ---------------------------------------------------------------------------

# Secretos -> NUNCA al repo
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# Dependencias
node_modules/
frontend/node_modules/
backend/node_modules/

# Compilacion de Solidity
artifacts/
cache/
typechain-types/

# Builds de frontend/backend
dist/
build/
coverage/
frontend/dist/
backend/dist/

# Instaladores y binarios pesados (se movieron fuera del proyecto)
node.msi
solc.exe
*.msi

# Logs
*.log
logs/*.log

# Copias de seguridad y snapshots
_backup-*/
*.zip

# Sistema operativo y editores
Thumbs.db
.DS_Store
.vscode/sessions.json
