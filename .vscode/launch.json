                "NODE_ENV": "development"
            }
        },
        {
            "name": "Deploy Contracts",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/crypto-suite-complete.js",
            "args": ["deploy"],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        }
    ]
}