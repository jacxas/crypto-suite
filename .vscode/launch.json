{
    "version": "0.2.0",
    "configurations": [
        
        
        
        


        




        

        {
            "name": "Debug Crypto Suite",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/crypto-suite-complete.js",
            "args": ["start"],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
